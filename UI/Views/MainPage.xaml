<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UI">

    <Grid Padding="32,16,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    Text="{Binding [app.title]}"
                    Style="{ThemeResource TitleTextBlockStyle}" />

                <TextBlock
                    Text="{Binding [app.subtitle]}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ComboBox
                x:Name="LanguageSelect"
                Grid.Row="0"
                Grid.Column="1"
                MinWidth="150"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                SelectedValuePath="Locale"
                SelectionChanged="OnLanguageChanged" />

            <Border
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <Grid x:Name="InstallPanel"
              Grid.Row="1"
              ColumnSpacing="8"
              MaxWidth="640"
              HorizontalAlignment="Left"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="GameSelect"
                      MinWidth="420"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      PlaceholderText="{Binding [install.placeholder]}"
                      DisplayMemberPath="Root"
                      SelectionChanged="OnGameSelected" />
            <Button x:Name="RescanButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{Binding [install.rescan]}"
                    Click="OnScanClick" />
            <Button x:Name="BrowseButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{Binding [install.browse]}"
                    Click="OnBrowseClick" />
        </Grid>

        <StackPanel x:Name="StartPanel"
                    Grid.Row="2"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
            <TextBlock Text="{Binding [scan.title]}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [scan.subtitle]}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="StartScanButton"
                        Style="{ThemeResource AccentButtonStyle}"
                        Content="{Binding [scan.action]}"
                        Click="OnScanClick" />
                <Button x:Name="StartBrowseButton"
                        Content="{Binding [install.browse]}"
                        Click="OnBrowseClick" />
            </StackPanel>
            <TextBlock x:Name="ScanStatus"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />
            <TextBlock Text="{Binding [scan.hint]}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="BusyPanel"
                    Grid.Row="2"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock x:Name="BusyMsg"
                       Text="{Binding [scan.progress]}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="EmptyPanel"
                    Grid.Row="2"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <TextBlock x:Name="EmptyMsg"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <Button x:Name="EmptyButton"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnEmptyActionClick" />
        </StackPanel>

        <Grid x:Name="ReviewPanel" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding [review.title]}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding [review.subtitle]}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Content="{Binding [review.refresh]}"
                        Click="OnRefreshClick" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,12,0">
                <controls:FileRules x:Name="Rules" SelectionChanged="OnRulesSelectionChanged" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3"
              ColumnSpacing="12"
              Padding="0,12,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <StackPanel.Resources>
                    <StaticResource x:Key="AccentButtonBackground" ResourceKey="DangerButtonBackground" />
                    <StaticResource x:Key="AccentButtonBackgroundPointerOver"
                                    ResourceKey="DangerButtonBackgroundPointerOver" />
                    <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="DangerButtonBackgroundPressed" />
                </StackPanel.Resources>
                <Button x:Name="BackButton"
                        Visibility="Collapsed"
                        Content="{Binding [review.back]}"
                        Click="OnBackClick" />
                <Button x:Name="UnstubButton"
                        IsEnabled="False"
                        Click="OnActClick"
                        Tag="unstub">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="{Binding [review.unstub]}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StubButton"
                        IsEnabled="False"
                        Click="OnActClick"
                        Tag="stub">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="13" />
                        <TextBlock Text="{Binding [review.stub]}" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="OnActClick"
                        Tag="delete">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="{Binding [review.delete]}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>